page { background: #f5f8f6; color: #173536; font-size: 30rpx; }
.page { padding: 32rpx; padding-bottom: 80rpx; }
.banner { background: #d9ede4; color: #174739; border-radius: 18rpx; padding: 20rpx 24rpx; font-size: 26rpx; margin-bottom: 24rpx; }
.title { font-size: 44rpx; font-weight: 700; margin: 14rpx 0 8rpx; }
.subtitle { color: #59716e; font-size: 26rpx; margin-bottom: 28rpx; }
.card { background: #fff; border: 1rpx solid #d7e4df; border-radius: 22rpx; padding: 28rpx; margin: 20rpx 0; box-shadow: 0 8rpx 20rpx rgba(18, 61, 58, .04); }
.card-title { font-weight: 700; font-size: 34rpx; margin-bottom: 14rpx; }
.row { display: flex; justify-content: space-between; gap: 20rpx; align-items: center; }
.muted { color: #617571; font-size: 25rpx; }
.notice { color: #905124; font-size: 26rpx; margin: 18rpx 0; }
.error { color: #a12d2d; font-size: 26rpx; margin: 18rpx 0; }
.field { margin: 24rpx 0; }
.label { display: block; font-weight: 600; font-size: 26rpx; margin-bottom: 10rpx; }
.control { box-sizing: border-box; width: 100%; min-height: 84rpx; padding: 22rpx; background: #f8fbf9; border: 1rpx solid #cbdcd6; border-radius: 14rpx; }
.button { background: #166451; color: #fff; border-radius: 15rpx; margin: 18rpx 0; font-weight: 600; }
.button::after { border: 0; }
.button[disabled] { background: #94aea5; color: #fff; }
.button-secondary { background: #e6f2ec; color: #174a3e; }
.button-danger { background: #f9ece8; color: #a1372d; }
.pill { border-radius: 99rpx; background: #e7f2ed; padding: 7rpx 18rpx; font-size: 24rpx; }
.nav { display: flex; gap: 14rpx; margin: 20rpx 0; }
.nav button { flex: 1; font-size: 25rpx; }
