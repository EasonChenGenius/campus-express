<view class="page">
  <view class="banner">代取员本机演示 · 虚构数据 · 未付款 · 不进行真实配送</view>
  <view class="hero"><view class="hero-kicker">CAMPUS EXPRESS · 代取员端</view><view class="row"><view class="title">代取任务</view><text class="pill">{{campusName}}</text></view><view class="subtitle">先查看本校区任务，接单后再读取取件信息。</view></view>
  <view class="nav">
    <button class="button button-secondary" bindtap="refresh" disabled="{{loading}}">刷新任务</button>
    <button class="button button-secondary" bindtap="switchAccount">切换测试身份</button>
  </view>
  <view class="card" wx:if="{{availability}}"><view class="card-title">接单能力</view><view>{{availability.online ? '已上线' : '已下线'}} · 同时处理 {{availability.activeCount}}/{{availability.maxActive}} 单</view><button class="button button-secondary" disabled="{{busy || (!availability.approved && !availability.online)}}" bindtap="toggleAvailability">{{availability.online ? '下线暂停新接单' : '上线接单'}}</button></view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="section-kicker section-gap">任务池</view><view class="card-title">本校区待接单 {{pool.length}}</view>
  <view class="muted" wx:if="{{!pool.length}}">暂无可接测试任务；未审核身份会收到拒绝提示。</view>
  <view class="card" wx:for="{{pool}}" wx:key="id">
    <view class="row"><text class="card-title">{{item.zone}}{{item.building ? ' · ' + item.building : ''}} · {{item.qty}} 件</text><text class="pill">{{item.statusName}}</text></view>
    <view>{{item.slotName}} · 模拟报价 ¥{{item.amountText}}</view>
    <view class="muted">接单前不显示取件码和交接位置 · {{item.shortId}}</view>
    <button class="button" data-id="{{item.id}}" disabled="{{busy || !canAccept}}" bindtap="accept">接单</button>
  </view>
  <view class="section-kicker section-gap">履约中</view><view class="card-title">我的任务 {{mine.length}}</view>
  <view class="muted" wx:if="{{!mine.length}}">还没有已接测试任务。</view>
  <view class="card" wx:for="{{mine}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder">
    <view class="row"><text class="card-title">{{item.zone}}{{item.building ? ' · ' + item.building : ''}} · {{item.qty}} 件</text><text class="pill">{{item.statusName}}</text></view>
    <view class="muted">订单 {{item.shortId}} · 点击查看详情与更新进度</view>
  </view>
</view>
