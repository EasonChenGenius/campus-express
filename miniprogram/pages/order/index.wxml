<view class="page">
  <view class="banner">订单详情仅用于测试 · 虚构取件码 · 未付款</view>
  <view class="title">订单详情</view>
  <button class="button button-secondary" bindtap="refresh" disabled="{{loading}}">刷新状态</button>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="card" wx:if="{{order}}">
    <view class="row"><text class="card-title">{{order.campusName}} · {{order.zone}}</text><text class="pill">{{order.statusName}}</text></view>
    <view class="field">包裹 {{order.qty}} 件 · {{order.slotName}}</view>
    <view class="field">模拟报价 ¥{{order.amountText}} · 未付款</view>
    <view class="field" wx:if="{{order.handoff}}">楼下当面交接点：{{order.handoff}}</view>
    <view class="field" wx:if="{{order.pickup_code}}">虚构取件码：{{order.pickup_code}}</view>
    <view class="muted">编号 {{order.shortId}} · {{order.createdText}}</view>
    <button class="button button-danger" wx:if="{{canCancel}}" data-action="cancel" disabled="{{busy}}" bindtap="doAction">取消测试订单</button>
    <button class="button" wx:if="{{canConfirm}}" data-action="confirm" disabled="{{busy}}" bindtap="doAction">确认收货</button>
    <button class="button" wx:if="{{canProgress}}" data-action="progress" disabled="{{busy}}" bindtap="doAction">{{nextLabel}}</button>
  </view>
</view>
