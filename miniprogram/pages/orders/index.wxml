<view class="page">
  <view class="banner">测试订单 · 虚构取件码 · 全部未付款</view>
  <view class="hero"><view class="hero-kicker">CAMPUS EXPRESS · 学生端</view><view class="row"><view class="title">我的订单</view><text class="pill">{{orders.length}} 单</text></view><view class="subtitle">查看预约、配送状态与交接进度。</view></view>
  <view class="nav">
    <button class="button button-secondary" bindtap="openCreate">返回下单</button>
    <button class="button button-secondary" bindtap="refresh" disabled="{{loading}}">刷新</button>
  </view>
  <view class="muted">页面可见时约每 15 秒同步；最近更新 {{lastUpdated || '尚未成功同步'}}。</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="muted" wx:if="{{empty}}">还没有测试订单。</view>
  <view class="card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="openOrder">
    <view class="row"><text class="card-title">{{item.campusName}} · {{item.zone}}{{item.building ? ' · ' + item.building : ''}}</text><text class="pill">{{item.statusName}}</text></view>
    <view>{{item.qty}} 件 · {{item.slotName}} · 模拟报价 ¥{{item.amountText}}</view>
    <view class="muted">订单 {{item.shortId}} · 未付款 · 点击查看详情</view>
  </view>
</view>
